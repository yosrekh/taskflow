# Database Configuration (DB_USER and DB_NAME must be specified; no default credentials are used)
DB_HOST=localhost
DB_NAME=taskflow_db
DB_USER=root
DB_PASS=

# Application Environment: 'production' or 'development'
# In production: display_errors is disabled, log_errors is enabled, and session cookies are always Secure
# Defaults to 'production' when omitted. Development mode must be explicitly opted into.
APP_ENV=development

# Application Timezone (defaults to Africa/Cairo)
APP_TIMEZONE=Africa/Cairo

# Session Cookie Name (defaults to TASKFLOW_SESSID)
SESSION_NAME=TASKFLOW_SESSID

# Optional custom log file path (defaults to server's PHP error log)
# LOG_FILE=/path/to/logs/error.log

# Automated test suite database override (development environment only)
# Opt-in override database used by local test suites (must end with _test)
# TEST_DB_NAME=taskflow_test

# -----------------------------------------------------------------------------
# Deployment Notes for Shared Hosting (cPanel) & Multi-Install Isolation:
# For optimal security on shared hosting (e.g. cPanel), place .env files
# ONE LEVEL ABOVE the project root directory (outside public_html / subdomains).
#
# TaskFlow checks configuration files in this strict priority order:
# 1. ../.env.<folder_name> (e.g. /home/user/.env.company-a.example.com)
#    -> Recommended for multi-tenant / multi-install setups sharing the same parent folder.
# 2. ../.env
#    -> Single-tenant fallback outside the web root.
# 3. ./.env
#    -> Local development inside project root.
# -----------------------------------------------------------------------------

