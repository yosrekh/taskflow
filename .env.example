# Database Configuration
DB_HOST=localhost
DB_NAME=taskflow_db
DB_USER=root
DB_PASS=

# Application Environment: 'production' or 'development'
# In production: display_errors is disabled, log_errors is enabled, and session cookies are always Secure
APP_ENV=development

# Application Timezone (defaults to Africa/Cairo)
APP_TIMEZONE=Africa/Cairo

# Session Cookie Name (defaults to TASKFLOW_SESSID)
SESSION_NAME=TASKFLOW_SESSID

# Optional custom log file path (defaults to server's PHP error log)
# LOG_FILE=/path/to/logs/error.log

# -----------------------------------------------------------------------------
# Deployment Note for Shared Hosting (cPanel):
# For optimal security on shared hosting (e.g. cPanel), place this .env file
# ONE LEVEL ABOVE the project root directory (outside public_html):
# e.g., /home/username/.env (outside /home/username/public_html or subdomain root).
# TaskFlow checks the parent directory first before falling back to the project root.
# -----------------------------------------------------------------------------
