# Disable directory indexing
Options -Indexes

# Set default landing page
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS redirect (301) only when not on localhost
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to dotfiles and dotfolders (except .well-known/ for SSL verification)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Deny access to protected directories
    RewriteRule ^(\.git|includes|bin|db|scratch)(/|$) - [F,L]
</IfModule>

# Deny access to sensitive file types
<FilesMatch "\.(md|sql|txt|log|ps1|sh)$">
    Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
